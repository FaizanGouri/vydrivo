# =====================================================================
# VYDRIVO Backend Production Configuration Template
# Copy this file to .env and adjust variables for your deployment
# =====================================================================

# Server Binding
HOST=127.0.0.1
PORT=8000

# CORS Allowed Origins (Comma-separated list of allowed domains)
# Example: https://vydrivo.com,https://www.vydrivo.com
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Concurrency & Resource Limits
MAX_CONCURRENT_JOBS=4
MAX_QUEUE_CAPACITY=25
JOB_TIMEOUT_SECONDS=300

# Optional explicit FFmpeg binary path (if not in system PATH)
# FFMPEG_PATH=/usr/bin/ffmpeg
